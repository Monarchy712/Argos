{
  "name": "@driftguard/watcher",
  "description": "Argos watcher: detects proxy upgrades on monitored contracts and publishes current_state / latest_change to Arkiv.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node --env-file=../.env src/main.ts",
    "rebaseline": "node --env-file=../.env src/rebaseline.ts",
    "renew": "node --env-file=../.env src/renew.ts",
    "seed": "node --env-file=../.env src/seed.ts",
    "recover": "node --env-file=../.env src/recover-cli.ts"
  },
  "dependencies": {
    "@driftguard/core": "0.1.0",
    "@driftguard/importer": "0.1.0",
    "@arkiv-network/sdk": "1.0.1",
    "viem": "2.56.3"
  }
}
