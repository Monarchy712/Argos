# Copy to .env and fill in. Never commit .env.
# Arkiv (Rabdi testnet)
ARKIV_WRITER_PRIVATE_KEY=
ARKIV_WATCHER_PRIVATE_KEY=
ARKIV_RPC_URL=
# optional: avoids the keyless rate limit for scripts (https://hub.arkiv.network/access-keys)
ARKIV_ACCESS_KEY=
# optional: mainnet RPC for the importer's proxy classification and the watcher
MAINNET_RPC_URL=
# Sepolia
SEPOLIA_RPC_URL=
SEPOLIA_DEPLOYER_PRIVATE_KEY=
# Swarm (only for uploads with your own postage batch; --public-gateway needs neither)
BEE_API_URL=
SWARM_POSTAGE_BATCH_ID=
# 0G Private Computer (https://pc.0g.ai → dashboard → API keys). Used to describe what changed
# between two implementations when Argos detects an upgrade. Read-only feature: without it the
# app still detects and warns, it just doesn't explain the diff.
ZEROG_API_KEY=
# optional: defaults to https://router-api.0g.ai/v1 (the OpenAI-compatible Compute Router)
ZEROG_BASE_URL=
