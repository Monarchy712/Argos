# Copy to .env and fill in. Never commit .env.
# Arkiv (Rabdi testnet)
ARKIV_WRITER_PRIVATE_KEY=
ARKIV_WATCHER_PRIVATE_KEY=
ARKIV_RPC_URL=
# optional: avoids the keyless rate limit for scripts (https://hub.arkiv.network/access-keys)
ARKIV_ACCESS_KEY=
# optional: mainnet RPC for the importer's proxy classification and the watcher
MAINNET_RPC_URL=
# Sepolia
SEPOLIA_RPC_URL=
SEPOLIA_DEPLOYER_PRIVATE_KEY=
# Swarm (only for uploads with your own postage batch; --public-gateway needs neither)
BEE_API_URL=
SWARM_POSTAGE_BATCH_ID=
# 0G Private Computer (https://pc.0g.ai → dashboard → API keys). Used to describe what changed
# between two implementations when Argos detects an upgrade. Read-only feature: without it the
# app still detects and warns, it just doesn't explain the diff.
ZEROG_API_KEY=
# optional: defaults to https://router-api.0g.ai/v1 (the OpenAI-compatible Compute Router)
ZEROG_BASE_URL=
# Baseline publisher (watcher/src/server.ts). The browser never holds a key: Add Contract asks
# this endpoint and the watcher signs the dg_baseline row with ARKIV_WRITER_PRIVATE_KEY.
# Leave ARGOS_HTTP_PORT empty to keep the endpoint off -- the UI then reports an honestly blocked
# publisher instead of a pending state that nobody will ever resolve.
# A number binds that port (local dev). On Railway/Render/Fly/Heroku use the literal value `auto`,
# which binds the platform's injected $PORT -- the only port those hosts route external traffic
# to. A hardcoded number there binds something nothing can reach: the service looks healthy and
# every publish times out.
ARGOS_HTTP_PORT=
# Shared secret the web build sends as `Authorization: Bearer`. Gates casual use of a write
# endpoint; it is not a user secret and it is not the Arkiv key.
ARGOS_PUBLISH_TOKEN=
# Comma-separated browser origins allowed to publish. Without it, browsers are refused.
ARGOS_ALLOWED_ORIGINS=
