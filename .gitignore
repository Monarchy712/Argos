# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem
keystore/
wallets/

# Node
node_modules/
dist/
.vite/
*.log
npm-debug.log*

# Foundry
contracts/out/
contracts/cache/
# Regenerated by `forge` from the submodule revisions, which git already pins in .gitmodules
contracts/foundry.lock
contracts/broadcast/*/31337/
contracts/broadcast/**/dry-run/

# Watcher local state (cursor files may contain nothing secret, but are machine-local)
watcher/state/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
# Local anvil deployments (Sepolia deployments ARE committed)
contracts/deployments/31337.json
contracts/broadcast/

# Local caches (registry checkout etc.)
.cache/

# Importer local caches
importer/state/
.vercel
.env*
# ...but the committed templates carry no values and are the only record of what an operator has
# to set. Re-included after the blanket rule above, which would otherwise swallow them (the root
# .env.example survived only because it was already tracked).
!.env.example
!**/.env.example
