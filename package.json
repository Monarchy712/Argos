{
  "name": "driftguard",
  "description": "Argos: contract-change detection and verification for ERC-7730 clear-signing descriptors, published on Arkiv.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.10"
  },
  "workspaces": [
    "packages/core",
    "watcher",
    "importer",
    "web"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"packages/*/test/*.test.ts\" \"watcher/test/*.test.ts\" \"importer/test/*.test.ts\" \"web/test/*.test.ts\"",
    "dev": "npm run dev -w web",
    "build": "npm run build -w web"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "@ethereum-sourcify/clear-signing": "0.3.1"
  }
}
